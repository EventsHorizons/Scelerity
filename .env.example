# Canonical production URL (set in Vercel → Project → Settings → Environment Variables).
# Example after adding a custom domain: https://scelerity.com
NEXT_PUBLIC_SITE_URL=

# Analytics — SEO OS Phase 12 (optional, enable in production)
# NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
# NEXT_PUBLIC_CLARITY_ID=xxxxxxxxxx

# Google Search Console verification (optional)
# NEXT_PUBLIC_GSC_VERIFICATION=your-verification-code

# Error monitoring (optional)
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# GitHub Pages only — do NOT set on Vercel (enables /Scelerity base path).
# GITHUB_PAGES=true
